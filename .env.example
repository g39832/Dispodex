# ──────────────────────────────────────────────────────────────────────────
#  Dispodex settings
#  Copy this file to ".env" (setup.ps1 does it for you) and edit the copy.
#  Lines starting with # are notes. Restart Dispodex after changing anything.
# ──────────────────────────────────────────────────────────────────────────

# ── Basics ─────────────────────────────────────────────────────────────────
PINKSHEET_BUSINESS_NAME=My Shop
PINKSHEET_PORT=8765
# 0.0.0.0 = other computers and phones on the shop network can connect.
PINKSHEET_HOST=0.0.0.0
PINKSHEET_TIME_ZONE=America/Chicago
# Leave blank to auto-create one in data/secret_key.txt (recommended).
DJANGO_SECRET_KEY=
# Never turn this on for the real shop server.
DJANGO_DEBUG=0
# Which addresses may reach the app. * works on a private network; list them if exposed online.
DJANGO_ALLOWED_HOSTS=*
# Required if you reach Dispodex over https (e.g. a Cloudflare tunnel): https://pinksheet.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to 1 when Dispodex sits behind an HTTPS proxy/tunnel. It then refuses to start unless
# PINKSHEET_REQUIRE_LOGIN=1, because a tunnel makes every visitor look like the shop.
PINKSHEET_BEHIND_HTTPS_PROXY=0
# 1 = everyone must sign in (create users with: python manage.py createsuperuser).
PINKSHEET_REQUIRE_LOGIN=0
PINKSHEET_MAINTENANCE_MODE=0
# 1 = public demo copy (never on the real shop server). See docs/demo.md.
PINKSHEET_DEMO_MODE=0

# ── Photos ─────────────────────────────────────────────────────────────────
PINKSHEET_PHOTO_MAX_MB=32
PINKSHEET_PHOTO_MAX_DIMENSION=1200
# The old app stored every photo as PNG; keep 1 to match, 0 keeps JPG/WebP as uploaded.
PINKSHEET_PHOTO_CONVERT_TO_PNG=1

# ── Backups ────────────────────────────────────────────────────────────────
# Nightly backups go to data/backups. Hour of day (0-23) they run:
BACKUP_HOUR=2
# Also copy each backup here (e.g. OneDrive) — leave blank to skip.
BACKUP_MIRROR_DIR=
# Copy photos here too (only new/changed files are copied) — leave blank to skip.
BACKUP_PHOTOS_MIRROR=
# How many backups to keep. 0 = keep them all.
BACKUP_KEEP=0

# ── Square (optional — fill these in whenever you're ready) ────────────────
# Easiest: run  python manage.py configure_square  and answer the questions.
# sandbox = Square's test store, production = the real store.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# 0 turns sync off without removing the keys.
SQUARE_SYNC_ENABLED=1
SQUARE_API_VERSION=2026-07-15
SQUARE_CURRENCY=USD
SQUARE_DEFAULT_QUANTITY=1
SQUARE_API_MAX_RETRIES=3
SQUARE_API_TIMEOUT_SECONDS=20
SQUARE_API_CONNECT_TIMEOUT_SECONDS=5
# Sales coming back from Square (webhooks). Needs a public HTTPS address.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must match EXACTLY what is registered in Square, e.g. https://pinksheet.example.com/webhooks/square/
SQUARE_WEBHOOK_NOTIFICATION_URL=
SQUARE_WEBHOOK_MAX_AGE_SECONDS=259200
# Reconciliation (Dispodex vs Square check) runs daily at this hour when Square is set up.
RECONCILE_HOUR=3

# ── eBay category list refresh (optional) ──────────────────────────────────
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# ── Zebra label printing via QZ Tray (optional) ───────────────────────────
# Put QZ Tray's digital-certificate.txt and private-key.pem in data/qz-signing/
# Origins allowed to request signatures (blank = same address as the app).
QZ_ALLOWED_ORIGINS=
